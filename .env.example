# ─── Required ────────────────────────────────────────────────────────────────
# App connection string. In production this role must NOT be a superuser,
# because row-level security is what enforces tenant isolation.
DATABASE_URL=postgres://vistabix_app:change-me@localhost:55432/vistabix
# Migration/seed connection. Owner of the schema. Never used by the app runtime.
DATABASE_URL_ADMIN=postgres://vistabix:change-me@localhost:55432/vistabix
# Integration tests use DATABASE_URL as the non-owner runtime role so row-level
# security is genuinely enforced. DATABASE_URL_ADMIN is the schema owner used by
# migrations and test fixtures. CI supplies both; no extra variables are needed.

APP_URL=http://localhost:3000
# 32+ random bytes. `openssl rand -base64 48`
AUTH_SECRET=
# 32-byte base64 key for provider tokens at rest. Required in production.
# `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# ─── Instagram / Meta ───────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=
GRAPH_VERSION=v23.0
# Business Discovery enrichment reads real creator rows only. It stays disabled
# (never simulated) until both of these are set.
META_DISCOVERY_TOKEN=
META_DISCOVERY_IG_USER_ID=
# Optional override of the OAuth scopes requested from Meta.
META_SCOPES=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
OUTREACH_FROM=partnerships@your-domain.com
# Must be exactly the domain part of OUTREACH_FROM (no @). Sender/domain alignment is validated at send time.
EMAIL_FROM_DOMAIN=your-domain.com
OUTREACH_REPLY_TO=partnerships@your-domain.com
OUTREACH_INBOX=partnerships@your-domain.com
# Your real physical mailing address, printed in every outreach email footer.
# Leave blank until you have a real address; never use a fabricated one.
OUTREACH_PHYSICAL_ADDRESS=

# ─── Payments (Stripe test mode) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AI (product studio) ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# ─── Google Docs export ────────────────────────────────────────────────────
# Set an OAuth refresh token with the Drive drive.file scope. Files are created
# in the connected Google account. The export email is the VistaBix login
# allowed to export, which must be an owner or admin in the active workspace.
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_DOCS_REFRESH_TOKEN=
GOOGLE_DOCS_EXPORT_USER_EMAIL=

# ─── Google sign-in (OAuth, separate client) ───────────────────────────────
# Use a dedicated OAuth client. Do NOT reuse GOOGLE_DOCS_* — those credentials
# belong to the Docs export account. Sign-in stays hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to ${APP_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# ─── Reserved provider credentials (not wired yet) ─────────────────────────
PDF_SERVICE_API_KEY=
PLAGIARISM_API_KEY=
AI_DETECTION_API_KEY=

# ─── Observability (optional) ───────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=

# ─── Backend service (FastAPI, port 8000) ───────────────────────────────────
# Whop credentials and the outreach daily cap belong in backend/.env, not here.
# See backend/.env.example for the complete set and the production safety rails.

# ─── Local seed only ────────────────────────────────────────────────────────
SEED_EMAIL=owner@vistabix.local
SEED_PASSWORD=choose-a-long-development-password
