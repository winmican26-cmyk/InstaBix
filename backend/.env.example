# InstaBix FastAPI backend — copy to .env and fill in real values.
#
# APP_ENV controls the Whop safety rail. In production a missing WHOP_API_KEY
# disables publishing (503). It never falls back to mock data in production.
APP_ENV=development
APP_VERSION=0.1.0

# SQLite is the zero-setup local default. Use a Postgres URL in production:
# DATABASE_URL=postgresql+psycopg://instabix_app:password@localhost:5432/instabix
DATABASE_URL=sqlite:///./instabix.db

# Optional. When set, every /api route except /api/health requires X-API-Key.
# Keep this server-side; never expose it in a browser bundle.
API_KEY=

# The starter frontend runs on 3100 so it can coexist with the root Next app.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
PUBLIC_APP_URL=http://localhost:3100

# Outreach settings exposed by GET /api/settings. Sending stays disabled until
# a verified domain is configured; the daily cap is workspace-scoped.
EMAIL_FROM_DOMAIN=
OUTREACH_DAILY_CAP=50

# Whop — current API (v1). Create a key at https://whop.com/dashboard/developer
# Use a sandbox key from https://sandbox.whop.com/dashboard/developer to test
# real API calls without moving money. Leave blank to use mock mode locally.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_API_BASE=https://api.whop.com/api/v1
WHOP_API_VERSION_DATE=2026-11-17-3
WHOP_TIMEOUT_SECONDS=20

# auto (default): mock without a key outside production, live with a key.
# true: force mock outside production (ignored in production).
# false: never mock; publishing is disabled when no key is present.
WHOP_MOCK_MODE=auto
